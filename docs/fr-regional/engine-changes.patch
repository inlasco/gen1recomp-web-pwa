--- love_orig/src/render/SafeImage.lua	1970-01-01 00:00:00.000000000 +0000
+++ love_src/src/render/SafeImage.lua	2026-08-15 08:56:37.795818513 +0000
@@ -0,0 +1,65 @@
+-- Load an optional image without betting the process on it.
+--
+-- Every optional asset in the UI was loaded as
+--
+--     local ok, img = pcall(love.graphics.newImage, path)
+--     return ok and img or nil
+--
+-- which is correct on desktop and NOT correct on the Web build.  love.js is
+-- compiled without catchable C++ exceptions, so a LÖVE exception unwinds
+-- straight past pcall and kills the main loop -- the same hazard
+-- src/core/WebViewport.lua already documents for love.filesystem.read on a
+-- missing file:
+--
+--     "love.filesystem.read on a MISSING file aborts this runtime ... getInfo
+--      is the only safe probe, and it is always taken first."
+--
+-- The consequence was not theoretical.  Yellow's title copyright line draws
+-- one extra tile after the GAME FREAK logo: the international release has a
+-- single "9" (NineTile) there, the French one has a two-tile "zeros" block,
+-- and the extractor only recognised the one-tile shape -- so on a French
+-- Yellow import assets/generated/title/nine.png was never written.  On
+-- desktop TitleState shrugged and drew nothing.  On iPhone the same pcall let
+-- the exception through and the game died on Play with LÖVE's pre-window
+-- alert, with the launcher still saying GOOD TO GO.
+--
+-- So: probe with getInfo, which returns nil instead of throwing, and only
+-- then load.  The pcall stays as a second net for a file that exists but is
+-- not decodable.
+
+local SafeImage = {}
+
+-- The only safe existence probe on this runtime: getInfo returns nil for a
+-- missing file instead of throwing.
+function SafeImage.exists(path)
+  if type(path) ~= "string" or path == "" then return false end
+  if love.filesystem and love.filesystem.getInfo then
+    return love.filesystem.getInfo(path, "file") ~= nil
+  end
+  return true
+end
+
+-- Optional image, or nil.  `path` may be nil.  `resolver` is applied to the
+-- path first (Assets.resolve, for mod-derived art) when supplied.
+function SafeImage.load(path, resolver)
+  if type(path) ~= "string" or path == "" then return nil end
+  local resolved = path
+  if resolver then
+    local okResolve, out = pcall(resolver, path)
+    if okResolve and type(out) == "string" and out ~= "" then resolved = out end
+  end
+  if not SafeImage.exists(resolved) then return nil end
+  local ok, img = pcall(love.graphics.newImage, resolved)
+  return ok and img or nil
+end
+
+-- An image built from ImageData already in memory: no file to miss, so the
+-- pcall really is the whole net here.  It lives next to load() so that every
+-- optional-image path in the engine goes through one place.
+function SafeImage.fromData(imageData)
+  if not imageData then return nil end
+  local ok, img = pcall(love.graphics.newImage, imageData)
+  return ok and img or nil
+end
+
+return SafeImage
