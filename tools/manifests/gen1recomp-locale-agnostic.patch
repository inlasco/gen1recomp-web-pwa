+def dex_measurement_system(entries):
+    """"imperial" (ft/in + 0.1 lb) or "metric" (dm + 0.1 kg).
+
+    Decided from what the entries actually parsed as, not from a locale guess:
+    every entry must agree, or the file is not shaped like either release and
+    the caller should stop rather than mis-read 151 records.
+    """
+    # Only the REAL entries vote.  The MissingNo./unused slots kept a
+    # leftover Japanese-format body (a placeholder kind, `db 10`, `dw 100`,
+    # no text_far) in every release, which reads as a single height byte and
+    # would otherwise make an English tree look mixed.  RomExtractor skips
+    # those species too.
+    real = [e for e in entries.values() if e.get("text")]
